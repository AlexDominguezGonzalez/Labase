# Copia este fichero como .env.local y rellena los valores. NUNCA lo subas con valores reales.
# Todas las variables se leen SOLO en el servidor (Route Handlers de app/api).

# URL del proyecto: Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (service_role o sb_secret_...). Salta RLS: jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Usuario y contraseña que pide el navegador para entrar en la app (proxy.ts).
# Obligatorias en producción (Vercel): sin ellas los endpoints responden 403.
# Usa una contraseña larga y aleatoria.
ACCESO_USUARIO=
ACCESO_CLAVE=

# Solo pon "true" si ya hay otra protección (red privada, Vercel Authentication...)
# delante de la app y no quieres usar ACCESO_USUARIO/ACCESO_CLAVE.
# ETL_PERMITIR_EN_PRODUCCION=false

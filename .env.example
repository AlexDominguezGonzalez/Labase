# Copia este fichero como .env.local y rellena los valores. NUNCA lo subas con valores reales.
# Todas las variables se leen SOLO en el servidor (Route Handlers de app/api).

# URL del proyecto: Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (service_role o sb_secret_...). Salta RLS: jamás con prefijo NEXT_PUBLIC_.
# También se acepta con el nombre SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: usuario y contraseña que pide el navegador para entrar en la app
# (proxy.ts). Sin ellas la app y sus endpoints quedan abiertos a cualquiera.
# ACCESO_USUARIO=
# ACCESO_CLAVE=

# Opcional: "true" desactiva los endpoints en producción.
# ETL_BLOQUEAR_EN_PRODUCCION=false
